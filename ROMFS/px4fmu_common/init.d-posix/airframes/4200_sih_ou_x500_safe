#!/bin/sh
#
# @name OU X500 V2 safe baseline (SIH)
#
# @type Quadrotor x
#

. ${R}etc/init.d-posix/airframes/10040_sihsim_quadx

# OU-PX4: the same safety envelope as 4200_ou_x500_safe (NuttX), on the built-in
# simulator-in-hardware model so scenarios run headless with no Gazebo.
param set-default MPC_THR_HOVER 0.466
param set-default GF_ACTION 2
param set-default GF_PREDICT 1
param set-default NAV_DLL_ACT 2
param set-default COM_DL_LOSS_T 10
param set-default NAV_RCL_ACT 2
param set-default COM_LOW_BAT_ACT 3
param set-default COM_ARM_WO_GPS 0
param set-default CBRK_FLIGHTTERM 0
param set-default CBRK_IO_SAFETY 0
param set-default CBRK_USB_CHK 0
param set-default CBRK_SUPPLY_CHK 0
param set-default EKF2_HGT_REF 1
param set-default EKF2_RNG_CTRL 0
param set-default EKF2_OF_CTRL 0
param set-default COM_MOT_TEST_EN 0
param set-default SDLOG_DIRS_MAX 100
param set-default MAV_2_BROADCAST 0

# ---- campus profile: limits sized for the UNKNOWN failure, not the expected flight ----
# 20 m ceiling / 50 m radius keep a runaway below the rooftops and in sight; RTL stays
# under the ceiling; climb rates halved so a runaway is slow enough to catch.
param set-default GF_MAX_VER_DIST 20
param set-default GF_MAX_HOR_DIST 50
param set-default MIS_TAKEOFF_ALT 3
param set-default RTL_RETURN_ALT 15
param set-default RTL_DESCEND_ALT 5
param set-default MPC_TKO_SPEED 1.0
param set-default MPC_Z_V_AUTO_UP 1.5
param set-default MPC_Z_VEL_MAX_UP 1.5
param set-default MPC_Z_V_AUTO_DN 1.0
param set-default MPC_XY_VEL_MAX 2.0
param set-default MPC_VEL_MANUAL 2.0
param set-default MPC_TILTMAX_AIR 30
param set-default MPC_LAND_SPEED 0.5
param set-default BAT_LOW_THR 0.20
param set-default BAT_CRIT_THR 0.12
param set-default BAT_EMERGEN_THR 0.08
param set-default COM_ARM_BAT_MIN 0.30
param set-default COM_FLT_TIME_MAX 900
param set-default COM_WIND_WARN 6
param set-default COM_WIND_MAX 8
param set-default COM_WIND_MAX_ACT 2
param set-default EKF2_REQ_NSATS 8
param set-default EKF2_REQ_EPH 2.0

# ---- companion-computer path: if offboard setpoints stop (agent crash, dashboard hang), RETURN --
# without this, an aircraft with no RC would hover in place until the battery died
param set-default COM_OBL_RC_ACT 3
param set-default COM_OF_LOSS_T 2.0
